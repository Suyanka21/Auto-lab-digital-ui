{
  "name": "autolab-independent-showroom",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests vite.config.ts",
    "test": "vitest run --maxWorkers=1",
    "test:e2e": "playwright test",
    "asset:gate": "node scripts/validate-glb.mjs --asset public/assets/3d/lexus-rx350/interior-l4-classic.glb --report reports/front-cabin-classic.json && node scripts/validate-glb.mjs --asset public/assets/3d/lexus-rx350/interior-l4-diamond.glb --report reports/front-cabin-diamond.json && node scripts/validate-glb.mjs --asset public/assets/3d/lexus-rx350/interior-l4-perforated.glb --report reports/front-cabin-perforated.json"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "lucide-react": "0.546.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1",
    "three-stdlib": "2.36.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "ajv": "8.20.0",
    "draco3dgltf": "1.5.9",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "gltf-validator": "2.0.0-dev.3.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
